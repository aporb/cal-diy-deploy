# cal.diy environment — copy to /opt/cal-diy/.env and fill secrets.
# Generate: NEXTAUTH_SECRET: openssl rand -base64 32
#           CALENDSO_ENCRYPTION_KEY: openssl rand -base64 24
#           CRON_API_KEY: openssl rand -hex 24
POSTGRES_USER=calcom
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=calendso
DATABASE_HOST=database:5432
DATABASE_URL=postgresql://calcom:<generate>@database:5432/calendso
DATABASE_DIRECT_URL=postgresql://calcom:<generate>@database:5432/calendso

NEXT_PUBLIC_WEBAPP_URL=https://book.harborgovcon.com
NEXT_PUBLIC_WEBSITE_URL=https://book.harborgovcon.com
WEBAPP_URL=https://book.harborgovcon.com
WEBSITE_URL=https://book.harborgovcon.com
NEXTAUTH_URL=https://book.harborgovcon.com/api/auth
NEXTAUTH_SECRET=<generate>
CALENDSO_ENCRYPTION_KEY=<generate>

CALCOM_TELEMETRY_DISABLED=1
NODE_ENV=production
ALLOWED_HOSTNAMES=["book.harborgovcon.com","127.0.0.1:3005","localhost:3005"]
ORGANIZATIONS_ENABLED=false
# Set true AFTER the first admin account exists.
DISABLE_SIGNUP=false
CRON_API_KEY=<generate>

# Transactional email via Resend (harborgovcon.com is a verified sending domain).
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=<RESEND_API_KEY>
EMAIL_SERVER_SECURE=true
EMAIL_FROM=HARBOR GovCon <noreply@harborgovcon.com>
